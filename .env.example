# Copy this file to .env (NOT committed) and fill in your key.
# Get a free key at https://aistudio.google.com  ->  "Get API key". No credit card needed.
GOOGLE_API_KEY=paste-your-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model the ADK agents use at runtime. Flash-Lite has the roomiest free daily quota.
# If you hit 404 or 429, check the model list and limits at https://aistudio.google.com/rate-limit
WORKSHOP_MODEL=gemini-3.5-flash-lite
